# Downloaded media — every top-level folder is an account archive (multi-GB).
# Ignore them all by default; only tooling dirs below are re-included.
/*/
!/.agents/
!/.claude/
!/docs/
!/src/
!/public/
!/e2e/
!/scripts/
!/electron/
!/build/
!/.github/

# Next.js app
/node_modules/
/.next/
/out/
/release/
/electron/node_modules/
/build/gallery-dl/
*.tsbuildinfo
next-env.d.ts
.env*
npm-debug.log*

# Playwright artifacts (the browser binaries live in %USERPROFILE%\AppData\Local\ms-playwright)
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# gather runtime state (settings, run records, logs)
/.gather/

# gallery-dl state and debris (belt-and-braces if a folder is un-ignored)
**/archive.sqlite3
**/archive.sqlite3-shm
**/archive.sqlite3-wal
*.part
*.part-*

# run logs from background downloads
*.log

# OS junk
Thumbs.db
desktop.ini
.DS_Store
