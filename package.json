{
  "name": "gather",
  "version": "0.1.6",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3210",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3210",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build:standalone": "next build && node scripts/prepare-standalone.mjs",
    "electron:install": "npm install --prefix electron",
    "fetch:gallery-dl": "node scripts/fetch-gallery-dl.mjs",
    "electron": "electron electron/main.cjs",
    "pack": "npm run build:standalone && npm run fetch:gallery-dl && electron-builder --win --dir",
    "dist": "npm run build:standalone && npm run fetch:gallery-dl && electron-builder --win",
    "test:e2e:mobile": "playwright test -c playwright.mobile.config.ts",
    "test:e2e:packaged": "playwright test -c playwright.packaged.config.ts"
  },
  "dependencies": {
    "next": "16.4.6",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
